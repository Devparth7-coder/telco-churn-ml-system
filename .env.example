# ---------------------------------------------------------------------------
# Environment configuration template.
# Copy to `.env` (never commit a real `.env`). Nothing here is required for a
# local run — sane defaults live in configs/config.yaml.
# ---------------------------------------------------------------------------

# --- Overrides (optional) ---------------------------------------------------
# CONFIG_PATH=configs/config.yaml
# RAW_DATA_PATH=data/raw/Telco-Customer-Churn.csv
# PROCESSED_DIR=data/processed
# MODEL_DIR=models
# PREDICTION_LOG_PATH=data/prediction_logs/predictions.jsonl
# API_HOST=0.0.0.0
# API_PORT=8000
# LOG_LEVEL=INFO

# --- Security ----------------------------------------------------------------
# When set, every API request must send: Authorization: Bearer <token>.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_AUTH_TOKEN=

# --- Comma-separated list of allowed CORS origins (empty disables CORS) ------
API_CORS_ORIGINS=
